<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTO Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="resort.product.mapper.HotelMapper">

	<!-- // 호텔 전체 검색 public List<HotelDTO> getHotelAll(); -->
	<select id="getHotelAll" resultType="HotelDTO">
		SELECT * FROM hotel
	</select>
	
	<!--  // 호텔 가격 public List<HotelPriceDTO> getHotelPrice();  -->
	<select id="getHotelPrice" resultType="HotelPriceDTO"> 
		SELECT h.h_code, MIN(r.price) as hotelPrice FROM hotel h 
		INNER JOIN room r 
		ON h.h_code = r.h_code 
		GROUP BY h.h_code 
	</select>
</mapper>
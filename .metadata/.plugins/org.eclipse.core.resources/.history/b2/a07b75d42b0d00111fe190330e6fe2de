package resort.board.dto;

import java.util.Date;

public class NoticeDTO{
	// 공지보드 DTO
	private int n_code; //공지사항코드
	private String n_title;//제목
	private Date n_date;//날짜
	private String n_content;//내용
	private Date n_update;//수정일자
	
	public int getN_code() {
		return n_code;
	}
	public void setN_code(int n_code) {
		this.n_code = n_code;
	}
	public String getN_title() {
		return n_title;
	}
	public void setN_title(String n_title) {
		this.n_title = n_title;
	}
	public Date getN_date() {
		return n_date;
	}
	public void setN_date(Date n_date) {
		this.n_date = n_date;
	}
	public String getN_content() {
		return n_content;
	}
	public void setN_content(String n_content) {
		this.n_content = n_content;
	}
	public Date getN_update() {
		return n_update;
	}
	public void setN_update(Date n_update) {
		this.n_update = n_update;
	}
	
	
}	

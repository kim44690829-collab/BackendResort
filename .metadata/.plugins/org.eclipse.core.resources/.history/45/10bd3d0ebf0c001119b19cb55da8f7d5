<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTO Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="resort.product.mapper.HotelMapper">

	<!-- // 호텔 전체 검색 public List<HotelDTO> getHotelAll(); -->
	<select id="getHotelAll" resultType="HotelDTO">
		SELECT * FROM hotel
	</select>
	
	<!-- 호텔의 가격을 출력하는  -->
	<select id="">
		SELECT h.h_code, MIN(r.price) as h_price FROM room r 
		INNER JOIN hotel h 
		ON r.h_code = h.h_code
		GROUP BY h.h_code;
	</select>
	
</mapper>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTO Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="resort.product.mapper.HotelMapper">

	<!-- // 호텔 전체 검색 public List<HotelDTO> getHotelAll(); -->
	<select id="getHotelAll" resultType="HotelDTO">
		SELECT * FROM hotel
	</select>
	
	<!-- (상세페이지 호텔과) 같은지역의 추천호텔 -->
	<select id="getRecommHotel" resultType="HotelDTO" >
		SELECT h.h_code,h.hotelName,h.country,h.city,h.type,h.h_address,h.discount,MIN(r.price) as 'minPrice' FROM hotel h
		INNER JOIN room r ON h.h_code = r.h_code
		WHERE h.city = #{hotelcity} and h.h_code != #{hotelcode}
		GROUP BY h.h_code
	</select>
	<!-- 호텔의 가격을 출력하는  -->
	<select id="getHotelPrice" resultType="HotelPriceDTO">
		SELECT h.h_code as p_h_code, MIN(r.price) as p_h_price FROM room r 
		INNER JOIN hotel h 
		ON r.h_code = h.h_code
		GROUP BY h.h_code;
	</select>

	<!-- 호텔의 별점을 출력하는  -->
	<select id="getHotelRating" resultType="HotelRatingDTO">
		SELECT h.h_code as 'r_h_code',  avg(rb.rb_score) as 'h_rating' FROM reviewboard rb 
		INNER JOIN room r 
		ON rb.r_code = r.r_code
		INNER JOIN hotel h ON h.h_code = r.h_code
		group by h.h_code
	</select>
	
	<!--  // 호텔 가격 public List<HotelPriceDTO> getHotelPrice();  -->
	<select id="getHotelPrice" resultType="HotelPriceDTO"> 
		SELECT h.h_code, MIN(r.price) as hotelPrice FROM hotel h 
		INNER JOIN room r 
		ON h.h_code = r.h_code 
		GROUP BY h.h_code 
	</select>
</mapper>